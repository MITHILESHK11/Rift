# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# MongoDB Connection URL (Paste mongodb+srv://... or mongodb://... string here)
MONGODB_URL=

# SQL Database URL (Defaults to SQLite; pass postgresql://... for Supabase in production)
DATABASE_URL=sqlite:///./sales_inbox.db

# Server Port
PORT=8000
